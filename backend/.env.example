# === Polymath OS Backend — Environment Variables ===

# MongoDB connection string (required)
MONGO_URL=mongodb://localhost:27017

# MongoDB database name (required)
DB_NAME=polymath_os

# OpenAI API key (required for AI features)
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# === Security Configuration ===

# Environment mode: development | staging | production
# - development: CORS allows all origins, no rate limiting, no auth required
# - staging: CORS restricted to known domains, rate limiting active
# - production: Strict CORS, rate limiting, auth recommended
ENVIRONMENT=development

# API key for protected endpoints (optional)
# When set in staging/production, requests must include X-API-Key header
# API_KEY=your-secure-api-key-here

# Rate limiting configuration
# RATE_LIMIT_REQUESTS: max requests per window (default: 100)
# RATE_LIMIT_WINDOW: window duration in seconds (default: 60)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Allowed CORS origins for production (comma-separated)
# Only used when ENVIRONMENT=production
# ALLOWED_ORIGINS=https://polymath-os.vercel.app,https://polymath-os.com

# === Sentry Error Tracking (optional) ===
# Get your DSN at https://sentry.io → Projects → Create → Python (FastAPI)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_RELEASE=polymath-backend@0.1.0

# === JWT Authentication (required for multi-user mode) ===
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-256-bit-random-secret-key-here
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# === Field-Level Encryption (required for sensitive data) ===
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=your-32-byte-base64-encryption-key-here

# === Password Policy ===
PASSWORD_MIN_LENGTH=12
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30
